          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.Volume" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.PhysicalDisk" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.NetworkAtcIntent" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.UpdateState" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.ArcIntegration" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.ResourceBridge" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.MonitoringPipeline" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.Service" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.ComputeComponent" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.StorageComponent" />
          <DiscoveryClass TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.NetworkComponent" />
