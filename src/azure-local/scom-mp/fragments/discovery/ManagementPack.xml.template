          <DiscoveryRelationship TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.DeploymentContainsVolume" />
          <DiscoveryRelationship TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.DeploymentContainsPhysicalDisk" />
          <DiscoveryRelationship TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.DeploymentContainsUpdateState" />
          <DiscoveryRelationship TypeID="HCSAzureLocalLibrary!HybridSolutionsCloud.AzureLocal.StoragePoolContainsVolume" />
