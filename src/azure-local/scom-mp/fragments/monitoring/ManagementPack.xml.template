              <ProbeAction ID="Probe" TypeID="Windows!Microsoft.Windows.PowerShellPropertyBagTriggerOnlyProbe">
                <ScriptName>HybridSolutionsCloud.AzureLocal.NodeHealth.Probe.ps1</ScriptName>
                <ScriptBody><![CDATA[
param($CpuWarningPercent, $CpuCriticalPercent, $MemoryWarningMB, $MemoryCriticalMB, $VolumeWarningPercentFree, $VolumeCriticalPercentFree)

$ErrorActionPreference = 'Stop'
$api = New-Object -ComObject 'MOM.ScriptAPI'
$bag = $api.CreatePropertyBag()

function Set-State {
    param([string]$Name, [string]$State, [string]$Detail)
    $bag.AddValue($Name, $State)
    $bag.AddValue($Name + 'Detail', $Detail)
}

function Get-ServiceSummary {
    param([string[]]$Names)
    $services = @(Get-Service -Name $Names -ErrorAction SilentlyContinue)
    if ($services.Count -eq 0) { return [pscustomobject]@{ State = 'NotApplicable'; Detail = 'No applicable services were found.' } }
    $stopped = @($services | Where-Object Status -ne 'Running')
    return [pscustomobject]@{
        State = $(if ($stopped.Count -gt 0) { 'Critical' } else { 'Good' })
        Detail = (($services | ForEach-Object { $_.Name + '=' + $_.Status }) -join '; ')
    }
}

try {
    Import-Module FailoverClusters -ErrorAction Stop
    $cluster = Get-Cluster -ErrorAction Stop

    $clusterService = Get-Service -Name ClusSvc -ErrorAction Stop
    Set-State 'ClusterServiceState' $(if ($clusterService.Status -eq 'Running') { 'Good' } else { 'Critical' }) ('ClusSvc=' + $clusterService.Status)

    $nodes = @(Get-ClusterNode -Cluster $cluster -ErrorAction Stop)
    $downNodes = @($nodes | Where-Object State -ne 'Up')
    Set-State 'ClusterNodeState' $(if ($downNodes.Count -gt 0) { 'Critical' } else { 'Good' }) ("Nodes not Up: {0}; total nodes: {1}; affected: {2}" -f $downNodes.Count, $nodes.Count, (($downNodes.Name) -join ', '))

    $quorum = Get-ClusterQuorum -Cluster $cluster -ErrorAction Stop
    $quorumResource = $null
    if ($quorum.QuorumResource) { $quorumResource = Get-ClusterResource -Name $quorum.QuorumResource -ErrorAction SilentlyContinue }
    $quorumState = if ($quorumResource -and $quorumResource.State -ne 'Online') { 'Critical' } else { 'Good' }
    Set-State 'QuorumState' $quorumState ("Type: {0}; resource: {1}; resource state: {2}" -f $quorum.QuorumType, $quorum.QuorumResource, $(if ($quorumResource) { $quorumResource.State } else { 'NotApplicable' }))

    $faults = @()
    if (Get-Command Get-HealthFault -ErrorAction SilentlyContinue) { $faults = @(Get-HealthFault -ErrorAction SilentlyContinue) }
    $criticalFaults = @($faults | Where-Object { [string]$_.Severity -match 'Critical|Major' -or [int]$_.PerceivedSeverity -ge 5 })
    $warningFaults = @($faults | Where-Object { $_ -notin $criticalFaults })
    $faultState = if ($criticalFaults.Count -gt 0) { 'Critical' } elseif ($warningFaults.Count -gt 0) { 'Warning' } else { 'Good' }
    Set-State 'HealthFaultState' $faultState ("Critical/major: {0}; other active: {1}; total: {2}" -f $criticalFaults.Count, $warningFaults.Count, $faults.Count)
    $bag.AddValue('ActiveHealthFaultCount', $faults.Count)

    $pools = @(Get-StoragePool -IsPrimordial $false -ErrorAction SilentlyContinue | Where-Object FriendlyName -NotLike 'Primordial*')
    $badPools = @($pools | Where-Object { [string]$_.HealthStatus -ne 'Healthy' -or $_.IsReadOnly })
    Set-State 'StoragePoolState' $(if ($badPools.Count -gt 0) { 'Critical' } else { 'Good' }) ("Unhealthy/read-only pools: {0}; total pools: {1}" -f $badPools.Count, $pools.Count)

    $volumes = @(Get-Volume -ErrorAction SilentlyContinue | Where-Object { $_.FileSystem -in @('CSVFS_ReFS','CSVFS_NTFS','ReFS') })
    $criticalVolumes = 0
    $warningVolumes = 0
    $lowestFree = 100
    foreach ($volume in $volumes) {
        if ([string]$volume.HealthStatus -ne 'Healthy') { $criticalVolumes++; continue }
        if ($volume.Size -gt 0) {
            $percentFree = ($volume.SizeRemaining / $volume.Size) * 100
            $lowestFree = [math]::Min($lowestFree, $percentFree)
            if ($percentFree -le [double]$VolumeCriticalPercentFree) { $criticalVolumes++ }
            elseif ($percentFree -le [double]$VolumeWarningPercentFree) { $warningVolumes++ }
        }
    }
    $csvs = @(Get-ClusterSharedVolume -Cluster $cluster -ErrorAction SilentlyContinue)
    $redirectedCsvs = @($csvs | Where-Object { $_.State -ne 'Online' -or $_.SharedVolumeInfo.RedirectedAccess })
    $criticalVolumes += $redirectedCsvs.Count
    $volumeState = if ($criticalVolumes -gt 0) { 'Critical' } elseif ($warningVolumes -gt 0) { 'Warning' } else { 'Good' }
    Set-State 'VolumeState' $volumeState ("Critical: {0}; warning: {1}; redirected/offline CSV: {2}; lowest free: {3:N2}%" -f $criticalVolumes, $warningVolumes, $redirectedCsvs.Count, $lowestFree)
    $bag.AddValue('VolumeLowestPercentFree', [math]::Round($lowestFree, 2))

    $disks = @(Get-PhysicalDisk -ErrorAction SilentlyContinue)
    $badDisks = @($disks | Where-Object { [string]$_.HealthStatus -ne 'Healthy' -or [string]$_.OperationalStatus -notmatch 'OK' })
    $diskState = if ($badDisks.Count -gt 1) { 'Critical' } elseif ($badDisks.Count -eq 1) { 'Warning' } else { 'Good' }
    Set-State 'PhysicalDiskState' $diskState ("Non-healthy disks: {0}; total disks: {1}" -f $badDisks.Count, $disks.Count)
    $bag.AddValue('NonHealthyPhysicalDiskCount', $badDisks.Count)

    if (Get-Command Get-NetIntentStatus -ErrorAction SilentlyContinue) {
        $intentStatus = @(Get-NetIntentStatus -ComputerName $env:COMPUTERNAME -ErrorAction SilentlyContinue)
        $failedIntent = @($intentStatus | Where-Object { [string]$_.ConfigurationStatus -notin @('Success','Completed','Provisioning') -or [string]$_.ProvisioningStatus -match 'Failed|Error' })
        Set-State 'NetworkAtcState' $(if ($failedIntent.Count -gt 0) { 'Critical' } else { 'Good' }) ("Unsuccessful intents: {0}; total intents: {1}" -f $failedIntent.Count, $intentStatus.Count)
    } else {
        Set-State 'NetworkAtcState' 'Critical' 'Network ATC cmdlets are unavailable on this Azure Local node.'
    }

    $registration = $null
    try { $registration = Get-AzureStackHCI -ErrorAction Stop } catch { $registration = $null }
    if ($registration) {
        $registrationState = if ([string]$registration.RegistrationStatus -ne 'Registered') { 'Critical' } elseif ([string]$registration.ConnectionStatus -ne 'Connected') { 'Warning' } else { 'Good' }
        Set-State 'RegistrationState' $registrationState ("Registration={0}; connection={1}; last connected={2}" -f $registration.RegistrationStatus, $registration.ConnectionStatus, $registration.LastConnected)
    } else {
        Set-State 'RegistrationState' 'Critical' 'Get-AzureStackHCI did not return registration state.'
    }

    $arcServices = Get-ServiceSummary @('himds','GCArcService','ExtensionService')
    $mocServices = @(Get-Service -ErrorAction SilentlyContinue | Where-Object { $_.Name -match 'moc|wssda' })
    $mocStopped = @($mocServices | Where-Object Status -ne 'Running')
    $platformState = if ($arcServices.State -eq 'Critical' -or $mocStopped.Count -gt 0) { 'Critical' } elseif ($arcServices.State -eq 'NotApplicable') { 'Warning' } else { 'Good' }
    Set-State 'PlatformServicesState' $platformState ("Arc: {0}; MOC services stopped: {1}; MOC services found: {2}" -f $arcServices.Detail, $mocStopped.Count, $mocServices.Count)

    $updates = @()
    if (Get-Command Get-SolutionUpdate -ErrorAction SilentlyContinue) { $updates = @(Get-SolutionUpdate -ErrorAction SilentlyContinue) }
    $failedUpdates = @($updates | Where-Object { [string]$_.State -match 'Failed|PreparationFailed|DownloadFailed' -or [string]$_.HealthState -match 'Error|Critical' })
    $warningUpdates = @($updates | Where-Object { [string]$_.State -match 'AdditionalContentRequired|Ready|Warning' })
    $updateState = if ($failedUpdates.Count -gt 0) { 'Critical' } elseif ($warningUpdates.Count -gt 0) { 'Warning' } else { 'Good' }
    Set-State 'UpdateState' $updateState ("Failed: {0}; attention: {1}; updates found: {2}" -f $failedUpdates.Count, $warningUpdates.Count, $updates.Count)

    $memory = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop
    $availableMemoryMB = [math]::Round($memory.FreePhysicalMemory / 1024, 0)
    $bag.AddValue('AvailableMemoryMB', $availableMemoryMB)
    $memoryState = if ($availableMemoryMB -le [double]$MemoryCriticalMB) { 'Critical' } elseif ($availableMemoryMB -le [double]$MemoryWarningMB) { 'Warning' } else { 'Good' }
    Set-State 'MemoryState' $memoryState ("Available memory: {0} MB" -f $availableMemoryMB)

    $cpuValue = [math]::Round((Get-CimInstance Win32_Processor | Measure-Object LoadPercentage -Average).Average, 2)
    $bag.AddValue('CpuPercent', $cpuValue)
    $cpuState = if ($cpuValue -ge [double]$CpuCriticalPercent) { 'Critical' } elseif ($cpuValue -ge [double]$CpuWarningPercent) { 'Warning' } else { 'Good' }
    Set-State 'CpuState' $cpuState ("Processor load: {0}%" -f $cpuValue)

    Set-State 'PipelineState' 'Good' ('Probe completed at ' + [DateTime]::UtcNow.ToString('o'))
} catch {
    foreach ($stateName in @('ClusterServiceState','ClusterNodeState','QuorumState','HealthFaultState','StoragePoolState','VolumeState','PhysicalDiskState','NetworkAtcState','RegistrationState','PlatformServicesState','UpdateState','MemoryState','CpuState','PipelineState')) {
        Set-State $stateName 'Critical' $_.Exception.Message
    }
    $api.LogScriptEvent('HybridSolutionsCloud.AzureLocal.NodeHealth.Probe.ps1', 8401, 1, $_.Exception.ToString())
}

$bag
]]></ScriptBody>
                <Parameters>
                  <Parameter><Name>CpuWarningPercent</Name><Value>$Config/CpuWarningPercent$</Value></Parameter><Parameter><Name>CpuCriticalPercent</Name><Value>$Config/CpuCriticalPercent$</Value></Parameter>
                  <Parameter><Name>MemoryWarningMB</Name><Value>$Config/MemoryWarningMB$</Value></Parameter><Parameter><Name>MemoryCriticalMB</Name><Value>$Config/MemoryCriticalMB$</Value></Parameter>
                  <Parameter><Name>VolumeWarningPercentFree</Name><Value>$Config/VolumeWarningPercentFree$</Value></Parameter><Parameter><Name>VolumeCriticalPercentFree</Name><Value>$Config/VolumeCriticalPercentFree$</Value></Parameter>
                </Parameters>
                <TimeoutSeconds>$Config/TimeoutSeconds$</TimeoutSeconds>
              </ProbeAction>
