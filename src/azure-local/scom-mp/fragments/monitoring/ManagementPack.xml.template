      <WriteActionModuleType ID="HybridSolutionsCloud.AzureLocal.DiagnosticSummary.WriteAction" Accessibility="Internal" Batching="false">
        <Configuration><xsd:element name="TimeoutSeconds" type="xsd:integer" minOccurs="1" /></Configuration>
        <OverrideableParameters><OverrideableParameter ID="TimeoutSeconds" Selector="$Config/TimeoutSeconds$" ParameterType="int" /></OverrideableParameters>
        <ModuleImplementation Isolation="Any"><Composite><MemberModules><WriteAction ID="PowerShell" TypeID="Windows!Microsoft.Windows.PowerShellWriteAction">
          <ScriptName>HybridSolutionsCloud.AzureLocal.DiagnosticSummary.Task.ps1</ScriptName>
          <ScriptBody><![CDATA[
$ErrorActionPreference = 'Stop'
Import-Module FailoverClusters -ErrorAction Stop
$cluster = Get-Cluster
$registration = try { Get-AzureStackHCI -ErrorAction Stop } catch { $null }
[pscustomobject]@{
    Computer = $env:COMPUTERNAME
    Cluster = $cluster.Name
    ClusterNodes = @(Get-ClusterNode).Count
    NodesNotUp = @(Get-ClusterNode | Where-Object State -ne 'Up').Count
    ActiveHealthFaults = @(Get-HealthFault -ErrorAction SilentlyContinue).Count
    StoragePoolsNotHealthy = @(Get-StoragePool -IsPrimordial $false | Where-Object HealthStatus -ne 'Healthy').Count
    VolumesNotHealthy = @(Get-Volume | Where-Object HealthStatus -ne 'Healthy').Count
    PhysicalDisksNotHealthy = @(Get-PhysicalDisk | Where-Object HealthStatus -ne 'Healthy').Count
    RegistrationStatus = $(if ($registration) { $registration.RegistrationStatus } else { 'Unknown' })
    ConnectionStatus = $(if ($registration) { $registration.ConnectionStatus } else { 'Unknown' })
    NetworkIntentsNotSuccessful = @(Get-NetIntentStatus -ErrorAction SilentlyContinue | Where-Object ConfigurationStatus -notin @('Success','Completed','Provisioning')).Count
} | Format-List | Out-String
]]></ScriptBody><Parameters /><TimeoutSeconds>$Config/TimeoutSeconds$</TimeoutSeconds>
        </WriteAction></MemberModules><Composition><Node ID="PowerShell" /></Composition></Composite></ModuleImplementation>
        <OutputType>System!System.BaseData</OutputType><InputType>System!System.BaseData</InputType>
      </WriteActionModuleType>
