              <ProbeAction ID="Probe" TypeID="Windows!Microsoft.Windows.PowerShellPropertyBagTriggerOnlyProbe">
                <ScriptName>HybridSolutionsCloud.HyperV.HostHealth.Probe.ps1</ScriptName>
                <ScriptBody><![CDATA[
param($CpuWarningPercent, $CpuCriticalPercent, $MemoryWarningMB, $MemoryCriticalMB, $CsvWarningPercentFree, $CsvCriticalPercentFree)

$ErrorActionPreference = 'Stop'
$api = New-Object -ComObject 'MOM.ScriptAPI'
$bag = $api.CreatePropertyBag()

function Set-State {
    param([string]$Name, [string]$State, [string]$Detail)
    $bag.AddValue($Name, $State)
    $bag.AddValue($Name + 'Detail', $Detail)
}

try {
    Import-Module Hyper-V -ErrorAction Stop

    $vmms = Get-Service -Name vmms -ErrorAction Stop
    Set-State 'VMMSState' $(if ($vmms.Status -eq 'Running') { 'Good' } else { 'Critical' }) ('Service status: ' + $vmms.Status)

    $memory = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop
    $availableMemoryMB = [math]::Round($memory.FreePhysicalMemory / 1024, 0)
    $bag.AddValue('AvailableMemoryMB', $availableMemoryMB)
    $memoryState = if ($availableMemoryMB -le [double]$MemoryCriticalMB) { 'Critical' } elseif ($availableMemoryMB -le [double]$MemoryWarningMB) { 'Warning' } else { 'Good' }
    Set-State 'MemoryState' $memoryState ("Available memory: {0} MB" -f $availableMemoryMB)

    $cpuValue = 0
    try { $cpuValue = [math]::Round((Get-Counter '\Hyper-V Hypervisor Logical Processor(_Total)\% Total Run Time' -ErrorAction Stop).CounterSamples[0].CookedValue, 2) } catch {
        $cpuValue = [math]::Round((Get-CimInstance Win32_Processor | Measure-Object LoadPercentage -Average).Average, 2)
    }
    $bag.AddValue('HypervisorCpuPercent', $cpuValue)
    $cpuState = if ($cpuValue -ge [double]$CpuCriticalPercent) { 'Critical' } elseif ($cpuValue -ge [double]$CpuWarningPercent) { 'Warning' } else { 'Good' }
    Set-State 'CpuState' $cpuState ("Hypervisor CPU: {0}%" -f $cpuValue)

    $vms = @(Get-VM -ErrorAction Stop)
    $unexpected = @($vms | Where-Object { $_.AutomaticStartAction -eq 'Start' -and $_.State -notin @('Running','Starting','Stopping','Saving','Pausing','Resuming') })
    $vmState = if ($unexpected.Count -gt 0) { 'Critical' } else { 'Good' }
    Set-State 'VirtualMachineState' $vmState ("Unexpected VM states: {0}; total VMs: {1}" -f $unexpected.Count, $vms.Count)
    $bag.AddValue('VirtualMachineCount', $vms.Count)
    $bag.AddValue('UnexpectedVirtualMachineCount', $unexpected.Count)

    $replications = @(Get-VMReplication -ErrorAction SilentlyContinue)
    $criticalReplication = @($replications | Where-Object { [string]$_.Health -eq 'Critical' })
    $warningReplication = @($replications | Where-Object { [string]$_.Health -eq 'Warning' })
    $replicationState = if ($criticalReplication.Count -gt 0) { 'Critical' } elseif ($warningReplication.Count -gt 0) { 'Warning' } else { 'Good' }
    Set-State 'ReplicationState' $replicationState ("Critical: {0}; warning: {1}; relationships: {2}" -f $criticalReplication.Count, $warningReplication.Count, $replications.Count)

    $clusterState = 'NotApplicable'
    $csvState = 'NotApplicable'
    try {
        Import-Module FailoverClusters -ErrorAction Stop
        $cluster = Get-Cluster -ErrorAction Stop
        $nodes = @(Get-ClusterNode -Cluster $cluster -ErrorAction Stop)
        $downNodes = @($nodes | Where-Object State -ne 'Up')
        $clusterState = if ($downNodes.Count -gt 0) { 'Critical' } else { 'Good' }
        Set-State 'ClusterState' $clusterState ("Nodes not Up: {0}; total nodes: {1}" -f $downNodes.Count, $nodes.Count)

        $csvs = @(Get-ClusterSharedVolume -Cluster $cluster -ErrorAction SilentlyContinue)
        $csvCritical = 0
        $csvWarning = 0
        $lowestFree = 100
        foreach ($csv in $csvs) {
            $partition = $csv.SharedVolumeInfo.Partition
            if ($partition.Size -gt 0) {
                $percentFree = ($partition.FreeSpace / $partition.Size) * 100
                $lowestFree = [math]::Min($lowestFree, $percentFree)
                if ($percentFree -le [double]$CsvCriticalPercentFree) { $csvCritical++ }
                elseif ($percentFree -le [double]$CsvWarningPercentFree) { $csvWarning++ }
            }
            if ($csv.State -ne 'Online' -or $csv.SharedVolumeInfo.RedirectedAccess) { $csvCritical++ }
        }
        $csvState = if ($csvCritical -gt 0) { 'Critical' } elseif ($csvWarning -gt 0) { 'Warning' } else { 'Good' }
        Set-State 'CsvState' $csvState ("Critical conditions: {0}; warning conditions: {1}; lowest free: {2:N2}%" -f $csvCritical, $csvWarning, $lowestFree)
        $bag.AddValue('CsvLowestPercentFree', [math]::Round($lowestFree, 2))
    } catch {
        Set-State 'ClusterState' 'NotApplicable' 'Failover Clustering is not present or this is a standalone host.'
        Set-State 'CsvState' 'NotApplicable' 'Cluster Shared Volumes are not applicable.'
    }

    if (Get-Command Get-NetIntentStatus -ErrorAction SilentlyContinue) {
        $intentStatus = @(Get-NetIntentStatus -ErrorAction SilentlyContinue)
        $failedIntent = @($intentStatus | Where-Object { [string]$_.ConfigurationStatus -notin @('Success','Provisioning') })
        $atcState = if ($failedIntent.Count -gt 0) { 'Critical' } else { 'Good' }
        Set-State 'NetworkAtcState' $atcState ("Unsuccessful intents: {0}; total intents: {1}" -f $failedIntent.Count, $intentStatus.Count)
    } else {
        Set-State 'NetworkAtcState' 'NotApplicable' 'Network ATC is not the networking authority on this host.'
    }

    Set-State 'PipelineState' 'Good' ('Probe completed at ' + [DateTime]::UtcNow.ToString('o'))
} catch {
    Set-State 'VMMSState' 'Critical' $_.Exception.Message
    Set-State 'CpuState' 'Critical' $_.Exception.Message
    Set-State 'MemoryState' 'Critical' $_.Exception.Message
    Set-State 'VirtualMachineState' 'Critical' $_.Exception.Message
    Set-State 'ReplicationState' 'Critical' $_.Exception.Message
    Set-State 'ClusterState' 'Critical' $_.Exception.Message
    Set-State 'CsvState' 'Critical' $_.Exception.Message
    Set-State 'NetworkAtcState' 'Critical' $_.Exception.Message
    Set-State 'PipelineState' 'Critical' $_.Exception.ToString()
    $api.LogScriptEvent('HybridSolutionsCloud.HyperV.HostHealth.Probe.ps1', 8201, 1, $_.Exception.ToString())
}

$bag
]]></ScriptBody>
